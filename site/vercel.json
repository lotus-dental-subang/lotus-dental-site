    {
      "source": "/product/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/featured_item/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/faq/(.*)",
      "destination": "/#faq",
      "permanent": true
    }
  ]
}